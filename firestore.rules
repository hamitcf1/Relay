rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get the current user's document
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if user is active
    function isActiveEmployee() {
      let userDoc = getUserDoc();
      return !('status' in userDoc) || userDoc.status != 'inactive';
    }
    
    // Helper function to get user's role from their document
    function getUserRole() {
      return getUserDoc().role;
    }
    
    // Helper function to check if user is GM
    function isGM() {
      return isAuthenticated() && isActiveEmployee() && getUserRole() == 'gm';
    }
    
    // Helper function to check if user belongs to the hotel
    function belongsToHotel(hotelId) {
      let userDoc = getUserDoc();
      return userDoc.hotel_id == hotelId && (!('status' in userDoc) || userDoc.status != 'inactive');
    }
    
    // A manager acting on one specific hotel's data.
    // The null check is what belongsToHotel alone cannot do: two accounts that both have no
    // hotel yet would otherwise satisfy (null == null) and be able to reach each other.
    // Used for every privileged write so a manager can only ever touch their own hotel.
    function managesHotel(hotelId) {
      return isGM() && getUserDoc().hotel_id != null && belongsToHotel(hotelId);
    }
    
    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Users can read their own document
      // GMs can read any user in their hotel
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (managesHotel(resource.data.hotel_id)) ||
        (resource != null && resource.data.hotel_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hotel_id)
      );
      
      // Users can only be created during registration (by themselves) OR by GMs.
      // A manager registering their own hotel has no hotel yet, so a self-created GM is
      // allowed only with a null hotel_id. That combination is inert: belongsToHotel fails
      // for every hotel, so it cannot be used to reach anyone else's data.
      allow create: if isAuthenticated() && (
        (request.auth.uid == userId && request.resource.data.role in ['receptionist', 'housekeeping']) ||
        (request.auth.uid == userId && request.resource.data.role == 'gm' && request.resource.data.hotel_id == null) ||
        (managesHotel(request.resource.data.hotel_id))
      );
      
      // Users can update their own non-role fields
      // Only GMs can update role field, and only for staff in their own hotel.
      // Without the hotel scope a manager could promote or demote staff of a different hotel.
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        (managesHotel(resource.data.hotel_id))
      );
      
      // Only GMs can delete users
      allow delete: if managesHotel(resource.data.hotel_id);
    }
    
    // ==========================================
    // HOTELS COLLECTION
    // ==========================================
    match /hotels/{hotelId} {
      // Anyone authenticated can read hotel info
      allow read: if isAuthenticated();
      
      // Anyone can create a hotel (during registration), but only under their own ownership.
      // Without the owner_id check any signed-in user could stamp someone else's uid on a
      // document and inherit that account's update rights.
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      
      // Only GM or hotel creator can update hotel.
      // The creator is identified by owner_id, which is the field createNewHotel actually writes.
      allow update: if isAuthenticated() && (
        (managesHotel(hotelId)) ||
        resource.data.owner_id == request.auth.uid
      );
      
      // Only GMs of that hotel can delete hotels
      allow delete: if managesHotel(hotelId);
      
      // ----------------------------------------
      // HOTEL SUBCOLLECTIONS
      // ----------------------------------------
      
      // LOGS - Real-time activity logs
      match /logs/{logId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create: if isAuthenticated() && belongsToHotel(hotelId);
        allow update: if isAuthenticated() && belongsToHotel(hotelId);
        allow delete: if managesHotel(hotelId);
      }
      
      // SHIFTS - Shift records
      match /shifts/{shiftId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create: if isAuthenticated() && belongsToHotel(hotelId);
        allow update: if isAuthenticated() && belongsToHotel(hotelId);
        allow delete: if managesHotel(hotelId);
      }
      
      // ROSTER - Weekly schedules (GM can edit, all can read)
      match /roster/{weekId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow write: if managesHotel(hotelId);
      }

      // Shared planning drafts are visible only to roster administrators.
      match /roster_drafts/{weekId} {
        allow read, write: if managesHotel(hotelId);
      }
      
      // INCIDENTS - Incident reports
      match /incidents/{incidentId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create: if isAuthenticated() && belongsToHotel(hotelId);
        allow update: if isAuthenticated() && belongsToHotel(hotelId);
        allow delete: if managesHotel(hotelId);
      }
      
      // Personal notes: only the owner and explicitly invited collaborators can read.
      match /personal_notes/{noteId} {
        function canAccessNote() {
          return isAuthenticated() && belongsToHotel(hotelId) &&
            (resource.data.owner_id == request.auth.uid || request.auth.uid in resource.data.collaborator_ids);
        }
        allow read: if canAccessNote();
        allow create: if isAuthenticated() && belongsToHotel(hotelId) &&
          request.resource.data.owner_id == request.auth.uid &&
          request.resource.data.collaborator_ids is list;
        allow update: if canAccessNote() &&
          request.resource.data.owner_id == resource.data.owner_id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            resource.data.owner_id == request.auth.uid
              ? ['title', 'content', 'tags', 'collaborator_ids', 'archived', 'deleted', 'updated_at']
              : ['title', 'content', 'tags', 'updated_at']);
        allow delete: if isAuthenticated() && belongsToHotel(hotelId) &&
          resource.data.owner_id == request.auth.uid;
      }

      // SHIFT_NOTES - Notes for all shifts
      match /shift_notes/{noteId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create: if isAuthenticated() && belongsToHotel(hotelId);
        allow update: if isAuthenticated() && belongsToHotel(hotelId);
        allow delete: if isAuthenticated() && (
          (managesHotel(hotelId)) ||
          resource.data.created_by == request.auth.uid
        );
      }
      
      // SETTINGS - Hotel settings (GM only write)
      match /settings/{settingId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow write: if managesHotel(hotelId);
      }
      
      // ACTIVITY_LOGS - Staff activity audit trail
      match /activity_logs/{logId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create, update: if isAuthenticated() && belongsToHotel(hotelId);
        allow delete: if false;

        // ActivityTracker stores the detailed five-minute segments below the
        // authenticated employee's deterministic daily activity document.
        match /sessions/{sessionId} {
          allow read: if isAuthenticated() && belongsToHotel(hotelId) && (
            isGM() || logId.matches('^' + request.auth.uid + '_.*')
          );
          allow create: if isAuthenticated()
            && belongsToHotel(hotelId)
            && logId.matches('^' + request.auth.uid + '_.*')
            && request.resource.data.keys().hasOnly([
              'start', 'end', 'duration_minutes'
            ])
            && request.resource.data.start is timestamp
            && request.resource.data.end is timestamp
            && request.resource.data.duration_minutes is number
            && request.resource.data.duration_minutes >= 0;
          allow update, delete: if false;
        }
      }

      // NOTIFICATIONS
      match /notifications/{notifId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow write: if isAuthenticated() && belongsToHotel(hotelId);
      }

      // DAILY_MENU
      match /daily_menu/{menuId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow write: if managesHotel(hotelId);
      }

      // TOURS
      match /tours/{tourId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow write: if managesHotel(hotelId);
      }

      // ROOMS
      match /rooms/{roomId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow write: if managesHotel(hotelId);
      }

      // SALES
      match /sales/{saleId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create: if isAuthenticated() && belongsToHotel(hotelId);
        allow update: if isAuthenticated() && belongsToHotel(hotelId);
        allow delete: if managesHotel(hotelId);
      }

      // CALENDAR_EVENTS
      match /calendar_events/{eventId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow write: if isAuthenticated() && belongsToHotel(hotelId);
      }

      // OFF_DAY_REQUESTS
      match /off_day_requests/{requestId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create: if isAuthenticated() && belongsToHotel(hotelId);
        allow update: if isAuthenticated() && belongsToHotel(hotelId);
        allow delete: if (managesHotel(hotelId)) ||
          (isAuthenticated() && belongsToHotel(hotelId) && resource.data.staff_id == request.auth.uid);
      }

      // MESSAGES - Private messaging
      match /messages/{messageId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create: if isAuthenticated() && belongsToHotel(hotelId);
        allow update: if isAuthenticated() && belongsToHotel(hotelId);
        allow delete: if managesHotel(hotelId);
      }

      // ANNOUNCEMENTS - one record per management announcement.
      // Read state lives on a per-person receipt rather than on the announcement itself,
      // because a shared is_read flag would mark the whole hotel as read after one open.
      match /announcements/{announcementId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);

        allow create: if managesHotel(hotelId) &&
          request.resource.data.createdBy == request.auth.uid;
        // Withdrawing and restoring an announcement are the only permitted edits.
        allow update: if managesHotel(hotelId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recalledAt', 'recalledByName']);
        allow delete: if managesHotel(hotelId);

        match /receipts/{uid} {
          // A person may read their own receipt; only GMs may read the whole audience.
          allow read: if isAuthenticated() && belongsToHotel(hotelId) &&
            (uid == request.auth.uid || isGM());
          allow write: if isAuthenticated() && belongsToHotel(hotelId) &&
            uid == request.auth.uid &&
            request.resource.data.keys().hasOnly(['uid', 'state', 'seenAt', 'dismissedAt', 'recalledAckAt']);
        }
      }

      // ANONYMOUS_FEEDBACK
      match /anonymous_feedback/{feedbackId} {
        allow read: if managesHotel(hotelId);
        allow create: if isAuthenticated(); // Allow any staff to submit anonymously
        allow update, delete: if managesHotel(hotelId);
      }

      // BLACKLISTS
      match /blacklists/{guestId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create: if isAuthenticated() && belongsToHotel(hotelId);
        allow update: if isAuthenticated() && belongsToHotel(hotelId);
        allow delete: if (managesHotel(hotelId)) ||
          (isAuthenticated() && belongsToHotel(hotelId) && resource.data.created_by == request.auth.uid);
      }

      // PRICING - Complex nested structure
      match /pricing/{configId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow write: if managesHotel(hotelId);
        
        // Handle sub-subcollections under pricing
        match /{allChildren=**} {
           allow read: if isAuthenticated() && belongsToHotel(hotelId);
           allow write: if managesHotel(hotelId);
        }
      }

      // SCORES - Office games leaderboard
      match /scores/{scoreId} {
        allow read: if isAuthenticated() && belongsToHotel(hotelId);
        allow create: if isAuthenticated() && belongsToHotel(hotelId);
        allow update, delete: if managesHotel(hotelId);
      }
    }
  }
}
